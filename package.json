		"@swc/jest": "^0.2.39",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@types/jest": "30.0.0",
		"@types/jest-when": "^3.5.5",
		"@types/node": "24.3.0",
		"@types/react": "19.2.14",
